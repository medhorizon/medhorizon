# Supabase (optional — without these, local SQLite is used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=dev-jwt-secret-change-me

# OpenAI-compatible API (optional — overrides MedHorizon provider when set)
# Precedence: env vars > MedHorizon ~/.config/medhorizon/medhorizon.jsonc > defaults
OPENAI_API_KEY=
# Leave empty to inherit MedHorizon provider baseURL; else e.g. https://api.openai.com/v1
OPENAI_BASE_URL=
# Leave empty to inherit MedHorizon default model id
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Optional: pin MedHorizon provider id (e.g. local-8317)
RESEARCH_GRAPH_PROVIDER=
# Optional: path to medhorizon.jsonc / openscience.json, or a config directory
MEDHORIZON_CONFIG=
MEDHORIZON_CONFIG_DIR=
OPENSCIENCE_CONFIG_DIR=

# Module
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4444,http://127.0.0.1:4444,http://localhost:5199,http://127.0.0.1:5199
RESEARCH_GRAPH_MODE=local
DATA_DIR=./data
SQLITE_PATH=./data/research-graph.db
PUBLIC_API_URL=http://127.0.0.1:8000
UI_URL=http://127.0.0.1:5173
GATEWAY_URL=http://127.0.0.1:5199

# Dev auth (local mode only — never use in production)
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# MedHorizon adapter (optional)
MEDHORIZON_SERVER_URL=http://127.0.0.1:4096
MEDHORIZON_ATLAS_BRIDGE=/api/atlas
MEDHORIZON_WEB_ORIGIN=http://127.0.0.1:4444
